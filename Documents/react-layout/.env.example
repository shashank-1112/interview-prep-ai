# Copy to .env.local for local dev (Vite loads .env.local automatically, and it's
# already gitignored). Every value has a working fallback in src/auth/config.ts,
# so this file only matters where the fallback is wrong for your environment.

# The shared .NET backend both the Angular app and this app call.
VITE_API_BASE_URL=https://megatradefairapi.azurewebsites.net

# Where the Angular app is hosted — used to build the login/home redirect URLs
# when this app finds no valid admin session.
VITE_ANGULAR_APP_URL=http://localhost:4300
VITE_ANGULAR_LOGIN_PATH=/login
VITE_ANGULAR_PLANNER_PATH=/stall-layout-planner

# Must match AuthSessionService's storageKey in the Angular app exactly.
VITE_AUTH_STORAGE_KEY=gs-exhibitor-auth-session
